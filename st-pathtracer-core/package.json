{
  "name": "@triforge/pathtracer-core",
  "version": "0.1.1",
  "description": "Raster-to-path-tracer toggle for Three.js — swap WebGLRenderer for a GPU path tracer at runtime, with multi-pass LightPath output (camera/diffuse/glossy/reflection)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node test/run-tests.js"
  },
  "author": "Aftab Ibrahim Kazi",
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.159.0",
    "three-gpu-pathtracer": ">=0.0.24",
    "three-mesh-bvh": ">=0.7.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AftabIbrahimKazi/triforge.git",
    "directory": "st-pathtracer-core"
  },
  "homepage": "https://github.com/AftabIbrahimKazi/triforge#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [
    "threejs",
    "three.js",
    "webgl",
    "path-tracing",
    "raytracing",
    "global-illumination",
    "typescript",
    "render-passes"
  ]
}

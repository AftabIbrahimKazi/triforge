{
  "name": "@triforge/render-budget-core",
  "version": "0.1.0",
  "description": "Engine-agnostic device/network profiling and render-quality budget planning — texture tier, shader complexity, context-count policy from real runtime probes, not heuristics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node test/run-tests.js",
    "bench": "node bench/run-bench.js"
  },
  "keywords": [
    "render-budget",
    "device-profiler",
    "webgl",
    "texture-variants",
    "three.js"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "author": "Aftab Ibrahim Kazi",
  "repository": {
    "type": "git",
    "url": "https://github.com/AftabIbrahimKazi/triforge.git",
    "directory": "render-budget-core"
  },
  "homepage": "https://github.com/AftabIbrahimKazi/triforge#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}

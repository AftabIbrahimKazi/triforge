{
  "name": "@triforge/compositor-core",
  "version": "0.1.3",
  "description": "Blender-matched post-processing compositor for Three.js — 28 passes (Bloom, Depth of Field, SSAO, SSR, LUT, Film Grain), backend-agnostic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node test/run-tests.js"
  },
  "keywords": [
    "three.js",
    "post-processing",
    "compositor",
    "blender",
    "effects",
    "threejs",
    "webgl",
    "bloom",
    "postprocessing",
    "ssao",
    "typescript",
    "vfx"
  ],
  "author": "Aftab Ibrahim Kazi",
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.128.0"
  },
  "peerDependenciesMeta": {
    "postprocessing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AftabIbrahimKazi/triforge.git",
    "directory": "st-compositor-core"
  },
  "homepage": "https://github.com/AftabIbrahimKazi/triforge#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
